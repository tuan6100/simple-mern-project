{
  "name": "student-management",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev:be": "cross-env EXPRESS_PORT=5000 npm run dev --workspace=backend",
    "dev:fe": "cross-env VITE_PORT=3000 npm run dev --workspace=frontend",
    "start:be": "cross-env EXPRESS_PORT=5000 nodemon ./backend/src/app.js",
    "wait:be": "wait-on http://localhost:5000/api-docs",
    "api": "openapi-generator-cli generate -i http://localhost:5000/api-docs -g typescript-axios -o ./frontend/api-client --skip-validate-spec",
    "serve": "concurrently -k \"npm:dev:be\" \"npm:dev:fe\"",
    "dev:api-fe": "npm-run-all wait:be api dev:fe",
    "dev": "concurrently -k \"npm:dev:be\" \"npm:dev:api-fe\"",
    "build": "npm run build --workspace=react",
    "test": "jest",
    "lint": "eslint ."
  },
  "dependencies": {
    "@openapitools/openapi-generator-cli": "^2.25.2",
    "axios": "^1.13.2",
    "body-parser": "^2.2.1",
    "cookie-parser": "~1.4.4",
    "cors": "^2.8.5",
    "debug": "~2.6.9",
    "express": "^5.2.1",
    "http-errors": "~1.6.3",
    "mongoose": "^9.0.0",
    "morgan": "^1.10.1",
    "nodemon": "^3.1.11",
    "pug": "3.0.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/jest": "^29.2.5",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jest": "^29.3.1",
    "npm-run-all": "^4.1.5",
    "vite": "^7.2.6",
    "wait-on": "^9.0.3"
  }
}
